# Copy to .env and fill in. Never commit .env.

# Optional. A fresh install opens a first-run setup in the dashboard that configures all of this; whatever is set
# here prefills it, and an access token plus an AI key set here skip it. Copy to .env to use: cp .env.example .env

# --- Recruiter access ---
# Required for anything other than local development. Without it the dashboard only
# answers direct requests from this machine. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

# The cloud backend (docs/CLOUD.md, deploy/cloud/): recruiters' accounts sign in to the dashboard through the
# HTTPS proxy in front of this app, and the desktop app connects here instead of running its own backend.
# Needs DATABASE_URL (PostgreSQL), SETTINGS_ENCRYPTION_KEY and an https:// PUBLIC_BASE_URL, or the app won't start.
REMOTE_DASHBOARD=false
# Proxies whose forwarded client address and protocol are believed (addresses or CIDR ranges). Empty: this host
# and private networks.
TRUSTED_PROXIES=
# A fixed installation id (32 hex characters) for a host without a persistent data folder. Empty: kept in DATA_DIR.
INSTALLATION_ID=

# Team sign-in through your own SSO proxy (see docs/DEPLOYMENT.md). Leave PROXY_AUTH_SECRET empty to
# trust no proxy. The proxy sends the secret in X-MIA-Proxy-Secret and the user's email and groups in
# the headers below; it must replace any copies of them sent by the browser.
PROXY_AUTH_SECRET=
PROXY_USER_HEADER=X-Forwarded-Email
PROXY_GROUPS_HEADER=X-Forwarded-Groups
# Comma-separated group names per role; the highest match wins. Others get PROXY_DEFAULT_ROLE
# (viewer, recruiter, admin, or none to refuse them).
PROXY_ADMIN_GROUPS=
PROXY_RECRUITER_GROUPS=
PROXY_VIEWER_GROUPS=
PROXY_DEFAULT_ROLE=recruiter

# --- AI provider: plans, screening, evaluation, and the interview's voice wherever it supports it ---
# Which providers cover what, and which have been tested: README, "One provider for the whole interview".
# auto: the first key set among ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY, XAI_API_KEY; none: templates (no AI).
# Or claude | gemini | openai | xai | ollama | offline. OpenAI and xAI also cover speech-to-text and the voice.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_PLAN_EFFORT=medium
CLAUDE_EVAL_EFFORT=high
# Gemini free tier may use submitted content to improve Google's products. Don't use it for real candidates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated models tried in order when the main one is overloaded, rate-limited or unreachable.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Gemini 3 thinking level (low | medium | high). Higher is slower: high made evaluations time out in testing.
GEMINI_PLAN_THINKING=low
GEMINI_EVAL_THINKING=medium
# OpenAI, or your own model on any OpenAI-compatible server (LLM_PROVIDER=openai). Leave OPENAI_BASE_URL empty
# for OpenAI; for example http://localhost:11434/v1 for Ollama. Self-hosted servers usually need no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=
# xAI (LLM_PROVIDER=xai): one key for plans, and (added in MeetStream too) for the whole interview.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
# Ollama on your own machine (LLM_PROVIDER=ollama): free, and nothing leaves the server. Pull a model first
# (ollama pull llama3.2); Settings > AI provider lists the ones installed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- General ---
# Shown in the dashboard's title and sidebar.
APP_NAME=Recruence
# IANA time zone for times written in emails (e.g. Asia/Kolkata, Europe/London). The dashboard uses each viewer's own.
TIME_ZONE=UTC
# Preselected interview length, in minutes, on the new interview form.
DEFAULT_DURATION_MINUTES=20

# --- MeetStream ---
# API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=
# Public https URL that reaches this app (MeetStream callbacks, live transcripts, MIA tools).
# Development: cloudflared tunnel --url http://localhost:8000   (only /webhooks/* is served through it)
PUBLIC_BASE_URL=
BOT_NAME=AI Interviewer
# How long MeetStream keeps the recording and transcript.
MEETSTREAM_RETENTION_HOURS=24
# Seconds the bot waits in the lobby (capped per platform: Meet 600, Zoom 1200, Teams 1800).
WAITING_ROOM_TIMEOUT=600

# --- MIA voice agent ---
# Every provider value MeetStream accepts, and which combinations have worked: README, "Choosing your providers".
# pipeline: separate speech-to-text, LLM and voice providers (below). realtime: one speech-to-speech
# model, e.g. Google Gemini Live (MIA_REALTIME_PROVIDER=google; needs a Google key in MeetStream Integrations).
MIA_MODE=pipeline
MIA_REALTIME_PROVIDER=google
MIA_REALTIME_MODEL=
MIA_REALTIME_VOICE=
# Realtime only, experimental: put the whole plan in the agent's instructions; it only calls end_interview,
# which reports consent and progress. Question order and the consent gate are then not enforced by the app.
MIA_REALTIME_INLINE_PLAN=false
# MIA uses provider keys saved in the MeetStream dashboard (Integrations), not this file.
# Empty: each part comes from the AI provider above, where it supports it. Set one only to fill a gap the AI provider
# leaves (Claude and Gemini have no speech-to-text or voice in MIA) or to use a different provider for that part,
# e.g. MIA_STT_PROVIDER=deepgram, MIA_TTS_PROVIDER=elevenlabs with MIA_VOICE=<your voice id>.
MIA_STT_PROVIDER=
MIA_STT_MODEL=
MIA_LLM_PROVIDER=
MIA_LLM_MODEL=
MIA_TTS_PROVIDER=
MIA_VOICE=
MIA_LANGUAGE=en
MAX_FOLLOW_UPS_PER_QUESTION=2
# Turn-taking. Silence (s) before the candidate's turn counts as over: raise if candidates get cut off.
MIA_MIN_ENDPOINTING_DELAY=1.5
MIA_MAX_ENDPOINTING_DELAY=6.0
MIA_VAD_MIN_SILENCE_MS=1000
# How much speech interrupts the agent: raise if its questions get cut off by noise.
MIA_INTERRUPT_MIN_SECONDS=1.0
MIA_INTERRUPT_MIN_WORDS=3
# After each call, transcribe the recording to recover the AI's spoken follow-ups, which MeetStream's
# live transcript doesn't include. MeetStream bills this transcription. Falls back to the live transcript.
POSTCALL_TRANSCRIPT=true
# Post the AI-interview and recording notice in the meeting chat when the bot joins (never on Zoom,
# where MeetStream showed the one message repeatedly).
CHAT_DISCLOSURE=true
POSTCALL_TIMEOUT_SECONDS=300
# Before each launch, check PUBLIC_BASE_URL's hostname resolves. A stopped quick tunnel's doesn't, and MeetStream
# then fails the agent setup with a bare 500. Turn off only if your DNS can't resolve your own public name.
CHECK_PUBLIC_URL=true

# --- Email: candidate invitations and "report ready" notes ---
# Without SMTP_HOST and SMTP_FROM nothing is sent; invitations can still be previewed and copied.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_REPLY_TO=
# How candidates ask for a human interviewer or an accommodation, shown in the invitation,
# e.g. "at talent@yourcompany.com". Empty: "by replying to this email".
RECRUITER_CONTACT=
# Comma-separated addresses that get a note when a report is ready.
NOTIFY_EMAILS=
# The dashboard's address, for links in those notes (optional).
DASHBOARD_URL=

# --- Report export (generic ATS hook, see docs/DEPLOYMENT.md) ---
# Each saved report and recruiter decision is POSTed here as JSON, signed with HMAC-SHA256 using the
# secret (at least 16 characters). https only, except to localhost. The transcript is left out unless
# REPORT_WEBHOOK_TRANSCRIPT=true.
REPORT_WEBHOOK_URL=
REPORT_WEBHOOK_SECRET=
REPORT_WEBHOOK_TRANSCRIPT=false

# --- Data ---
DATA_DIR=data
# Database. Empty: a SQLite file in DATA_DIR (nothing to run). Or PostgreSQL, e.g.
#   DATABASE_URL=postgresql://mia:password@localhost:5432/mia
# (pip install -r requirements-postgres.txt outside Docker). The schema is created and upgraded on start.
# Moving existing data: python scripts/copy_db.py --from data/interviewer.db --to <DATABASE_URL>
DATABASE_URL=
# Docker Compose's optional postgres service (--profile postgres) uses this password.
# POSTGRES_PASSWORD=
# Finished interviews (resume, transcripts, reports) are deleted after this many days. 0 keeps them.
DATA_RETENTION_DAYS=30
LOG_LEVEL=INFO
# Settings saved from the dashboard override the values above; keys and passwords among them are encrypted
# with this Fernet key. Empty: a key is generated once at DATA_DIR/settings.key (keep it with your backups,
# apart from the database). Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# --- Development only: database checks (npm run test:db, docs/ELECTRON.md) ---
# Put real values in .env.test.local (git-ignored), never here. Placeholders only.
# MIA_TEST_NEON_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# MIA_TEST_SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# --- Desktop app (docs/ELECTRON.md) ---
# Set by the desktop app itself; listed so the names are known. A .env in %APPDATA%\Recruence\data is read too.
# MIA_DESKTOP_PORT=8765

# --- Careers site integration (docs/DEMO_SITE.md) ---
# Websites (origins) whose own pages may show a role and submit applications to Recruence's public application API.
# Comma-separated, e.g. https://careers.example.com or http://127.0.0.1:8300 for the demo site. Empty: none.
PUBLIC_CORS_ORIGINS=

# --- Development only ---
# Several people (team setup, joining codes, more than one account) need a hosted PostgreSQL database. This lifts
# that for SQLite; never set it on a real installation.
# MIA_ALLOW_SHARED_SQLITE=false
