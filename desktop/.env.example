# Recruence desktop app (docs/CLOUD.md). The desktop app reads these from the environment it's started in.
# Instead of an environment variable you can choose the server in the app: Settings → System → Desktop app connection,
# or the "Connect to" box on the startup error page. That choice is saved in %APPDATA%\Recruence\desktop.json.

# The cloud backend's https:// address. Set: the app connects to it and never runs a backend on this computer.
# Empty: the app runs the backend on this computer (local mode, as before; interviews need this computer on).
RECRUENCE_SERVER_URL=

# Development only: http://localhost:8000 or http://127.0.0.1:8000 is accepted for a backend on this computer.
# Another data folder for the desktop app (tests, a second profile). Empty: %APPDATA%\Recruence.
MIA_USERDATA=
