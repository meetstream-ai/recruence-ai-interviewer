# Recruence cloud backend (docs/CLOUD.md). Copy to deploy/cloud/.env and fill in. Never commit the filled-in file.
# Every other setting from the main .env.example works here too; the ones below are what a cloud backend needs.

# --- Required ---
# The Neon PostgreSQL connection string (Neon → your project → Connection details). Use the pooled host.
DATABASE_URL=
# The key that encrypts the API keys saved from Settings. Use the SAME key the desktop app used, or the keys saved
# there can't be read: on Windows it's the contents of %APPDATA%\Recruence\data\settings.key.
SETTINGS_ENCRYPTION_KEY=
# This backend's public https:// address (your domain). Candidates' links and MeetStream's webhooks use it.
PUBLIC_BASE_URL=https://recruence.example.com

# --- Recommended ---
# A fixed id for this installation (32 hex characters), so it stays the same if the host's disk is replaced.
# Generate one with: python -c "import secrets; print(secrets.token_hex(16))"
INSTALLATION_ID=
# Proxies whose forwarded client address and protocol are believed (addresses or CIDR ranges, comma separated).
# Empty: this host and private networks (Caddy or cloudflared in this compose file are covered).
TRUSTED_PROXIES=
# Websites whose visitors' browsers post applications straight to a role's application API (comma separated).
# Not needed for a careers site whose own server forwards applications (MeetStream Careers, Larkspur Labs).
PUBLIC_CORS_ORIGINS=

# --- HTTPS in front of the app: one of these (docker-compose.yml profiles) ---
# --profile caddy: your domain's name, its DNS pointing at this server.
DOMAIN=
# --profile tunnel: the token of a named Cloudflare Tunnel whose public hostname points to http://app:8000.
TUNNEL_TOKEN=

# --- Optional: set here, or from the dashboard's Settings once signed in ---
MEETSTREAM_API_KEY=
LLM_PROVIDER=auto
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TIME_ZONE=UTC
